# LeadPilot AI Environment Configuration

# Server Port (Default: 5000)
PORT=5000

# MongoDB URI (Optional: Leave blank to use built-in embedded in-memory MongoDB)
MONGODB_URI=

# AI API Key (Optional: Leave blank to use intelligent deterministic ICP heuristic qualification in DEMO_MODE)
AI_API_KEY=

# Demo Mode Flag (Set to true to force deterministic mock scoring even if AI_API_KEY is present)
DEMO_MODE=true
